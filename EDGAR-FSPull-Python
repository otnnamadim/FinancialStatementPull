import pandas as pd
import requests

def get_company_facts(cik: str, user_agent: str) -> dict:

    padded_cik = cik.zfill(10)
    url = f"https://data.sec.gov/api/xbrl/companyfacts/CIK{padded_cik}.json"
    headers = {"User-Agent": user_agent, "Accept-Encoding": "gzip, deflate"}

    print(f"Fetching data from: {url}")
    response = requests.get(url, headers=headers)

    if response.status_code == 200:
        return response.json()
    else:
        response.raise_for_status()

def extract_fsli_to_dataframe(company_json: dict, fsli_name: str) -> pd.DataFrame:
     """Extracts 10-K & 10-Q financial statement line items and flattens JSON structure into a Pandas DataFrame."""

    try:
        us_gaap_statements = company_json["facts"]["us-gaap"]
        if fsli_name not in us_gaap_statements:
            raise KeyError(
                f"Financial statement line item '{fsli_name}' not found in this company's facts."
            )

        fsli_data = us_gaap_statements[fsli_name]
        unit_key = list(fsli_data["units"].keys())[0]
        financial_statements = fsli_data["units"][unit_key]
        df = pd.DataFrame(financial_statements)

        # Keep only major reference columns for structural clarity

        columns_to_keep = [
                "form",
                "fy",
                "fp",
                "start",
                "end",
                "val",
                "accn",
                "frame",
        ]
    
# Filter for only existing columns

        df = df[[col for col in columns_to_keep if col in df.columns]]
        return df

    except KeyError as e:
        print(f"Error parsing JSON structure: {e}")
        return pd.DataFrame()

def list_available_gaap_metrics(facts_json: dict) -> pd.DataFrame:
    """Efficiently extracts all available US-GAAP concepts from the JSON payload

    and returns them as a summary DataFrame.
    """
    try:
        # Step 1: Navigate straight to the US-GAAP dictionary branch
        us_gaap_facts = facts_json["facts"]["us-gaap"]

        # Step 2: Use a list comprehension to efficiently pull the concept names
        # and count how many data records live inside their first unit key
        summary_data = []
        for concept, details in us_gaap_facts.items():
            # Get the first unit of measure (e.g., 'USD')
            first_unit = list(details["units"].keys())[0]
            # Count how many historical observations exist for this metric
            record_count = len(details["units"][first_unit])

            summary_data.append(
                {"GAAP_Concept": concept, "Data_Points_Count": record_count}
            )

        # Step 3: Convert the lightweight summary list into a DataFrame
        summary_df = pd.DataFrame(summary_data)

        # Sort alphabetically or by the most heavily reported metrics
        return summary_df.sort_values(by="GAAP_Concept").reset_index(drop=True)

    except KeyError:
        print("Could not find standard 'us-gaap' facts for this company.")
        return pd.DataFrame()



