    MY_USER_AGENT = "YourName AdminContact@yourdomain.com"

    # Example: Vertiv Co. ($VRT) CIK: 0001674101
    VERTIV_CIK = "0001674101"

    try:
        # 2. Fetch the payload
        raw_facts = get_company_facts(VERTIV_CIK, MY_USER_AGENT)
        print(f"Successfully retrieved facts for: {raw_facts.get('entityName')}\n")

        # 3. Extract specific GAAP line items
        # Common concepts include: 'Assets', 'NetIncomeLoss', 'Revenues', 'OperatingIncomeLoss'
        target_concept = "Assets"
        assets_df = extract_metric_to_dataframe(raw_facts, target_concept)

        if not assets_df.empty:
            print(f"--- Historical Records for '{target_concept}' (Truncated) ---")
            # Filter for just the headline annual (10-K) and quarterly (10-Q) records
            filtered_df = assets_df[assets_df["form"].isin(["10-K", "10-Q"])].tail(
                15
            )
            print(filtered_df.to_string(index=False))

    except Exception as err:
        print(f"Execution failed: {err}")
