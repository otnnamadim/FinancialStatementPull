import pandas as pd
import time
from EDGAR_Pipeline import investment_watchlist, get_company_facts, extract_fsli_to_dataframe

USER_AGENT = "your@email.com"

METRIC_MAPPING = {
    "Total Assets": {"us-gaap": "Assets", "ifrs-full": "Assets"},
    "Total Equity": {"us-gaap": "StockholdersEquity", "ifrs-full": "Equity"},
    "Liabilities": {"us-gaap": "Liabilities", "ifrs-full": "Liabilities"},
    "Total Income": {"us-gaap": "NetIncomeLoss", "ifrs-full": "ProfitLoss"},
    "Total Revenue": {"us-gaap": "Revenues", "ifrs-full": "Revenue"}
}


def get_latest_value(df: pd.DataFrame) -> float:
    """Helper to extract the most recent annual (10-K/20-F) or trailing value from the extracted dataframe."""
    if df.empty:
        return None

    # Filter for full-year / annual reports to maintain comparability, or fall back to latest form
    annuals = df[df["form"].isin(["10-K", "20-F"])]
    target_df = annuals if not annuals.empty else df

    # Sort by fiscal year and fiscal period to get the latest data point
    target_df = target_df.sort_values(by=["fy", "fp"], ascending=[False, False])
    return target_df.iloc[0]["val"]


if __name__ == "__main__":
    print("=== STARTING SEC DATA PULL ===")

    watchlist_df = investment_watchlist()
    print(f"\n--- Investment Watchlist Loaded ({len(watchlist_df)} companies) ---")

    # Initialize empty columns for our metrics
    for metric in METRIC_MAPPING.keys():
        watchlist_df[metric] = None

    # Loop through each company to extract financials
    for idx, row in watchlist_df.iterrows():
        cik = row["cik"]
        ticker = row["ticker"]
        print(f"\nProcessing {row['company_name']} ({ticker})...")

        try:
            # 1. Fetch the master company JSON data
            company_json = get_company_facts(cik, USER_AGENT)

            # Determine standard based on what is available in the payload
            facts = company_json.get("facts", {})
            standard = "us-gaap" if "us-gaap" in facts else "ifrs-full" if "ifrs-full" in facts else None

            if not standard:
                print(f"⚠️ Could not identify standard for {ticker}. Skipping metrics.")
                continue

            # 2. Extract each financial statement line item
            for metric_name, taxonomy_keys in METRIC_MAPPING.items():
                fsli_key = taxonomy_keys[standard]

                # Safely attempt to extract data using your previous function
                try:
                    metric_df = extract_fsli_to_dataframe(company_json, fsli_key)
                    latest_val = get_latest_value(metric_df)

                    # Update our watchlist DataFrame
                    watchlist_df.at[idx, metric_name] = latest_val
                except Exception as e:
                    print(f"   ❌ Failed to parse {metric_name} ({fsli_key}): {e}")

            # 3. SEC Compliance Rate Limiting (Max 10 requests/sec)
            time.sleep(0.15)

        except Exception as e:
            print(f"💥 Critical error pulling data for {ticker}: {e}")


    display_cols = ["ticker", "category", "Total Assets", "Total Equity",
                    "Total Income", "Total Revenue", "Liabilities"]
    existing_cols = [c for c in display_cols if c in watchlist_df.columns]
    print(watchlist_df[existing_cols])
    print("\n=== DATA PULL COMPLETE ===")
